{
  "entities": {
    "UserTranslation": {
      "title": "User Translation",
      "description": "A user's personal translation of a specific verse.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user." },
        "book": { "type": "string", "description": "The name of the book (e.g., Genesis)." },
        "chapter": { "type": "integer", "description": "The chapter number." },
        "verse": { "type": "integer", "description": "The verse number." },
        "translation": { "type": "string", "description": "The user's translation text." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "The timestamp of the last update." }
      },
      "required": ["userId", "book", "chapter", "verse", "translation"]
    },
    "VerseNote": {
      "title": "Verse Note",
      "description": "Personal notes for a specific verse.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user." },
        "book": { "type": "string", "description": "The name of the book." },
        "chapter": { "type": "integer", "description": "The chapter number." },
        "verse": { "type": "integer", "description": "The verse number." },
        "content": { "type": "string", "description": "The note content." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "The timestamp of the last update." }
      },
      "required": ["userId", "book", "chapter", "verse", "content"]
    }
  },
  "firestore": {
    "/translations/{translationId}": {
      "schema": "UserTranslation",
      "description": "Collection of user translations."
    },
    "/notes/{noteId}": {
      "schema": "VerseNote",
      "description": "Collection of user notes."
    }
  }
}
